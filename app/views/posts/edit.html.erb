<h1>Edit Post</h1>

<% if @post.errors.any? %>
  <ul>
    <% @post.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<form action="<%= post_path(@post.id) %>" method="post">
  <%= method_field(:patch) %>
  <p><%= text_field(:title, @post.title) %></p>
  <p><%= text_area(:body, @post.body) %></p>
  <p><%= submit('Update') %></p>
</form>
