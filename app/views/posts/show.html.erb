<h1><%= @post.title %></h1>
<p><%= @post.body %></p>
<p><%= link_to('Edit', "/posts/#{@post.id}/edit") %></p>
<form action="/posts/<%= @post.id %>" method="post">
  <%= method_field(:delete) %>
  <%= submit('Delete') %>
</form>
<p><%= link_to('Back', '/posts') %></p>

<h2>Comments</h2>
<ul>
  <% @comments.to_a.each do |comment| %>
    <li><%= comment.body %></li>
  <% end %>
</ul>
