<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <title>mini-rails blog</title>
    <%= stylesheet_link_tag('/application.css') %>
    <%= javascript_include_tag('/application.js') %>
  </head>
  <body>
    <% if flash[:notice] %>
      <p><%= flash[:notice] %></p>
    <% end %>
    <% if flash[:alert] %>
      <p><%= flash[:alert] %></p>
    <% end %>
    <%= yield %>
  </body>
</html>
